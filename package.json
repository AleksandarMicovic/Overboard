{
  "name": "overboard",
  "version": "0.1.0",
  "description": "A modern, dependency-free chess board viewer. FEN, PGN, SVG piece themes, no engine.",
  "type": "module",
  "main": "./dist/overboard.js",
  "module": "./src/overboard.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/overboard.js",
      "default": "./dist/overboard.js"
    },
    "./dist/overboard.js": "./dist/overboard.js"
  },
  "files": ["src", "dist", "index.d.ts"],
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/",
    "test:perft": "node --test test/perft.test.js"
  },
  "keywords": ["chess", "chessboard", "fen", "pgn", "svg", "viewer", "anki"],
  "license": "MIT",
  "sideEffects": false
}
